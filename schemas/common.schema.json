{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-kit.invalid/schemas/common.schema.json",
  "title": "Common bounded identifiers",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f:])[^/]+(?:/[^/]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    }
  }
}
