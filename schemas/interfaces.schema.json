{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interface catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interfaces",
    "$schema"
  ],
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "purpose",
          "fields",
          "invariants",
          "decision_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$",
            "minLength": 1,
            "maxLength": 2048
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 1000
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 1000,
            "uniqueItems": true
          },
          "decision_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ADR-[0-9]{3}$",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 1000
          }
        }
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "$schema": {
      "const": "https://architecture-kit.invalid/schemas/interfaces.schema.json"
    }
  },
  "$id": "https://architecture-kit.invalid/schemas/interfaces.schema.json"
}
