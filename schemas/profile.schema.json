{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture target profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "title",
    "purpose",
    "assumes",
    "essential",
    "recommended",
    "optional",
    "defer",
    "excludes",
    "cost",
    "minimum_evidence"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 2048
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "assumes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "essential": {
      "$ref": "#/$defs/ids"
    },
    "recommended": {
      "$ref": "#/$defs/ids"
    },
    "optional": {
      "$ref": "#/$defs/ids"
    },
    "defer": {
      "$ref": "#/$defs/ids"
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_effort",
        "runtime_cost",
        "external_services",
        "hardware"
      ],
      "properties": {
        "build_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "very-high"
          ]
        },
        "runtime_cost": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "external_services": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "hardware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "minimum_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "source",
          "focused-test",
          "build",
          "activation",
          "live",
          "release"
        ]
      },
      "maxItems": 1000
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]+$",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 1000
    }
  },
  "$id": "https://architecture-kit.invalid/schemas/profile.schema.json"
}
