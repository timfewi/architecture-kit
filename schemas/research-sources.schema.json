{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-kit.invalid/schemas/research-sources.schema.json",
  "title": "Inspected primary-source register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "https://architecture-kit.invalid/schemas/research-sources.schema.json"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "retrieved_on",
          "content_sha256",
          "coverage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https://"
          },
          "retrieved_on": {
            "type": "string",
            "format": "date",
            "maxLength": 10
          },
          "content_sha256": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "coverage": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    }
  }
}
