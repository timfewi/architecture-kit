{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-kit.invalid/schemas/harness-tools.schema.json",
  "title": "Reviewed local harness tools and adopted lessons",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "reviewed_on",
    "scope",
    "collection_files",
    "sources",
    "lessons"
  ],
  "properties": {
    "$schema": {
      "const": "https://architecture-kit.invalid/schemas/harness-tools.schema.json"
    },
    "version": {
      "const": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "collection_files": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/digest"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "checkout",
          "role",
          "purpose",
          "observation",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "checkout": {
            "type": "string",
            "pattern": "^(public|private)/[a-z_][a-z0-9_-]*$"
          },
          "role": {
            "enum": [
              "tool",
              "kit",
              "mirror",
              "empty",
              "archive",
              "preparation"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "files": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "sources",
          "adopted_in"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L[0-9]{2}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "adopted_in": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
