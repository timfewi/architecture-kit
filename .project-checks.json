{
  "version": 1,
  "checks": [
    {
      "name": "kit-fast",
      "argv": ["nix", "develop", "--no-write-lock-file", "path:.", "--command", "just", "check-fast"],
      "requires": ["nix"],
      "timeout_seconds": 900,
      "profiles": ["fast"]
    },
    {
      "name": "kit-acceptance",
      "argv": ["nix", "develop", "--no-write-lock-file", "path:.", "--command", "just", "check"],
      "requires": ["nix"],
      "timeout_seconds": 3600,
      "profiles": ["full"]
    }
  ],
  "watch_ignore": [".direnv", "result", "result-*", "__pycache__", ".ruff_cache"]
}
